# Semua opsional. Tanpa file .env pun aplikasi tetap jalan.
PORT=3000
# JWT_SECRET=isi-dengan-string-acak-panjang   (kalau kosong dibuat otomatis)
# ── Terjemahan isi berita ke bahasa Inggris (pilih salah satu, atau kosongkan untuk MyMemory gratis) ──
# GOOGLE_TRANSLATE_API_KEY=                    (kualitas terbaik; Google Cloud Translation)
# LIBRETRANSLATE_URL=http://localhost:5000     (LibreTranslate yang dihosting sendiri, gratis)
# LIBRETRANSLATE_API_KEY=
# MYMEMORY_EMAIL=emailkamu@contoh.com          (menaikkan kuota harian MyMemory)
# AUTO_SEED=false                              (matikan berita contoh otomatis)
